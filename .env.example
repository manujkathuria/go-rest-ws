# Server HTTP Configuration
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=15s

# Logging Configuration (json | text, and debug | info | warn | error)
LOG_FORMAT=json
LOG_LEVEL=info

# Database Configuration (PostgreSQL runtime role)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=go_rest_ws
DB_USER=appuser
DB_PASSWORD=appuser_dev_pw
DB_SSLMODE=disable
